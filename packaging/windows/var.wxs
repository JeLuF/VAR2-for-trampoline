<!--
  Windows installer for VAR for Trampoline (WiX Toolset 5).
  Built by build-msi.ps1, which stages the application and the GStreamer runtime.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="VAR for Trampoline"
           Manufacturer="VAR for Trampoline"
           Version="$(Version)"
           UpgradeCode="657469B4-F947-4B23-A3B5-AAA32483CF20"
           Scope="perMachine">
    <!-- Same version replaces too, so test builds with an unchanged version number
         don't end up installed twice. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of VAR for Trampoline is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon for the shortcuts and the "Installed apps" entry. -->
    <Icon Id="VarIcon" SourceFile="!(bindpath.assets)\var.ico" />
    <Property Id="ARPPRODUCTICON" Value="VarIcon" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VAR for Trampoline" />
    </StandardDirectory>

    <Feature Id="Main" Title="VAR for Trampoline">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Everything staged by build-msi.ps1: var.exe, var-check.exe, GStreamer DLLs and
         plugins, licences. -->
    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.stage)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuVar" Name="VAR for Trampoline">
        <Component Id="StartMenuShortcut" Guid="C26A19B1-E1E5-45E0-8DF2-BEB84120B6A1">
          <Shortcut Id="ApplicationShortcut"
                    Name="VAR for Trampoline"
                    Target="[INSTALLFOLDER]var.exe"
                    Icon="VarIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <!-- For a first test of a machine without capture cards. -->
          <Shortcut Id="TestModeShortcut"
                    Name="VAR for Trampoline (test cameras)"
                    Description="Two synthetic test cameras and the debug overlay"
                    Target="[INSTALLFOLDER]var.exe"
                    Icon="VarIcon"
                    Arguments="--synthetic-cameras 2 --debug-overlay"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuVar" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\VAR for Trampoline"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="7D0B6E1A-3C55-4F0B-9B7E-2F1D8E4A6C11">
        <Shortcut Id="DesktopApplicationShortcut"
                  Name="VAR for Trampoline"
                  Target="[INSTALLFOLDER]var.exe"
                  Icon="VarIcon"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKLM" Key="Software\VAR for Trampoline"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
